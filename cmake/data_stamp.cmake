# Writes OUT: a header whose content changes whenever one of FILES (the files data.cpp
# #embeds) does. ccache's direct mode hashes included headers but not #embed'ed files;
# data.cpp includes this, so editing data/ can never yield a stale cached object.
set(stamp "// Generated by cmake/data_stamp.cmake: SHA-256 of the files data.cpp #embeds.\n")
foreach(f IN LISTS FILES)
  file(SHA256 "${f}" h)
  get_filename_component(n "${f}" NAME)
  string(APPEND stamp "// ${h} ${n}\n")
endforeach()
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL stamp)
  file(WRITE "${OUT}" "${stamp}")
endif()
